# =============================================================================
# Vaultix API Gateway - Environment Variables Configuration
# =============================================================================

# Server Port
SERVER_PORT=8085

# Eureka Service Discovery
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://localhost:8761/eureka/

# Cross-Origin Resource Sharing (CORS)
VAULTIX_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VAULTIX_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
VAULTIX_CORS_ALLOWED_HEADERS=*
VAULTIX_CORS_ALLOW_CREDENTIALS=true
VAULTIX_CORS_MAX_AGE=3600

# MaxMind GeoLite2 City Database Path
VAULTIX_GEOIP_DATABASE_PATH=../infra/geoip/GeoLite2-City.mmdb
